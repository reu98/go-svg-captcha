go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a

# Folders
_obj
_test
bin/
dist/

# Architecture specific extensions/prefixes
*.[568vq]
[568vq].out

# cgo generated files
_cgo_defun.c
_cgo_gotypes.go
_cgo_export.*

# Test coverage
*.coverprofile

# Temporary files
tmp/
temp/
.tmp/

# Build artifacts
build/
release/

# Environment variables
.env
.env.local
.env.*.local

# Debug files
__debug_bin

# Profiling data
*.prof
*.pprof
cpu.prof
mem.prof

